{
  "stores": {
    "secretario": {
      "name": "secretario",
      "host": "secretario.railway.internal",
      "port": 8200,
      "protocol": "http",
      "address": "http://secretario.railway.internal:8200",
      "token": "${SECRETARIO_TOKEN}",
      "headers": {
        "X-Vault-Token": "${SECRETARIO_TOKEN}"
      },
      "kv": {
        "engine": "kv-v2",
        "mount": "secret",
        "dataPath": "/v1/secret/data/<path>"
      },
      "healthCheck": "http://secretario.railway.internal:8200/v1/sys/health",
      "type": "Secretario"
    }
  },
  "organizations": [
    {
      "id": "org-platform",
      "name": "Platform Organization",
      "description": "Primary platform organization for the testmaster user."
    }
  ],
  "groups": [
    {
      "id": "platform-admins",
      "name": "Platform Admins",
      "organizationId": "org-platform",
      "description": "Administrators for the platform environment."
    },
    {
      "id": "platform-readers",
      "name": "Platform Readers",
      "organizationId": "org-platform",
      "description": "Read-only access to platform resources."
    },
    {
      "id": "railway-operators",
      "name": "Railway Operators",
      "organizationId": "org-platform",
      "description": "Operators for Railway VM orchestration samples."
    }
  ],
  "users": [
    {
      "id": "testmaster",
      "username": "testmaster",
      "email": "testmaster@example.com",
      "organizationId": "org-platform",
      "groupIds": ["platform-admins"],
      "roles": ["admin"]
    },
    {
      "id": "monitorer",
      "username": "monitorer",
      "email": "monitorer@example.com",
      "organizationId": "org-platform",
      "groupIds": ["platform-readers"],
      "roles": ["reader"]
    },
    {
      "id": "userrail",
      "username": "userrail",
      "email": "userrail@example.com",
      "organizationId": "org-platform",
      "groupIds": ["railway-operators"],
      "roles": ["vm-operator"]
    },
    {
      "id": "marek",
      "username": "marek",
      "email": "marek.krejpsky@gmail.com",
      "organizationId": "org-platform",
      "groupIds": ["platform-admins"],
      "roles": ["admin"]
    }
  ],
  "userEnvironments": [
    {
      "id": "testmaster-dev",
      "userId": "testmaster",
      "name": "dev",
      "organizationId": "org-platform",
      "secretRefs": [
        {
          "key": "DB_PASSWORD",
          "store": "secretario",
          "path": "app/testmaster/dev"
        }
      ]
    },
    {
      "id": "monitorer-dev",
      "userId": "monitorer",
      "name": "dev",
      "organizationId": "org-platform",
      "secretRefs": [
        {
          "key": "DB_PASSWORD",
          "store": "secretario",
          "path": "app/monitorer/dev"
        }
      ]
    },
    {
      "id": "userrail-dev",
      "userId": "userrail",
      "name": "dev",
      "organizationId": "org-platform",
      "secretRefs": [
        {
          "key": "DB_PASSWORD",
          "store": "secretario",
          "path": "app/userrail/dev"
        }
      ]
    },
    {
      "id": "marek-dev",
      "userId": "marek",
      "name": "dev",
      "organizationId": "org-platform",
      "secretRefs": [
        {
          "key": "DB_PASSWORD",
          "store": "secretario",
          "path": "app/marek/dev"
        }
      ]
    }
  ],
  "acls": [
    {
      "id": "testmaster-secrets-manager",
      "subjectType": "user",
      "subjectId": "testmaster",
      "resourceType": "plugin",
      "resourceId": "secrets-manager",
